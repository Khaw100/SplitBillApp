# Copy to .env and fill in. Never commit .env.
# ── App login ─────────────────────────────────────────────
APP_USERNAME=wipiii
# bcrypt hash of the app password (generate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'PASS', bcrypt.gensalt()).decode())")
APP_PASSWORD_BCRYPT=

# ── Session signing (generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# ── Wipiii Hub integration (LLM keys live here, not in this app) ──
HUB_PROJECT_ID=2
HUB_PROJECT_API_KEY=
HUB_API_BASE=https://dashboard.rakhawiratama.com/api/v1

# ── Public URL (used for cookie secure flag) ─────────────
PUBLIC_ORIGIN=https://splitbill.rakhawiratama.com
